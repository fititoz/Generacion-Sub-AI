# config.ini.example - Plantilla de configuración para el traductor de subtítulos MKV
# INSTRUCCIONES:
# 1. Copia este archivo como config.ini
# 2. Rellena TUS valores reales (api_key, base_url, rutas, etc.)
# 3. NO subas config.ini a Git (está en .gitignore)
# 4. Las RUTAS son por máquina: si copias este archivo entre hosts
#    (Windows <-> Linux/Sonarr), revisa mkvtoolnix_dir, theme_cache_dir y
#    anime_path. El programa avisará en el log las rutas que no existan.

[API]
# Credenciales y endpoint universal (compatible OpenAI format)
# Proveedores soportados: OpenRouter, OpenAI, Together, Groq, Ollama, vLLM, etc.
# Obtén tu API key en: https://openrouter.ai/keys (o tu proveedor)
api_key = TU_API_KEY_AQUI
# Ejemplos de base_url:
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI oficial: https://api.openai.com/v1
# Ollama local: http://localhost:11434/v1
# Together AI: https://api.together.xyz/v1
# Tu servidor local: http://localhost:20128/v1
base_url = http://localhost:20128/v1

[LLM_SETTINGS]
# Modelo a usar (formato proveedor/modelo o nombre simple)
# Ejemplos: openai/gpt-4o-mini, google/gemini-2.5-flash, meta-llama/llama-4-scout, gpt-4o-mini, llama3.2, auto/best-free
model = auto/best-free

# Tamaño del lote para enviar a la API
batch_size = 50

# Delay en segundos entre llamadas API (lotes o fallback individual)
api_call_delay = 5.0

# NOTA: la escalera de reintentos es interna (3 intentos, base 2s con
# backoff exponencial). Las antiguas claves api_max_retries /
# api_retry_initial_delay ya no tienen efecto.

# Timeout en segundos para llamadas API individuales (fallback)
api_single_timeout = 120

# Timeout en segundos para llamadas API por lotes
api_batch_timeout = 300

# Segundos a esperar si todos los modelos alcanzan rate limit (error 429)
rate_limit_wait_seconds = 60

# Temperatura de muestreo (0.0 = determinista, 1.0 = creativo)
temperature = 0.3

# Máximo de tokens en respuesta
max_tokens = 2000

# CONSEJO: con ASS muy taggeados (SubsPlus+ etc.) y lotes de 50, 2000 tokens
# se corta (finish_reason=length). Usa 4000 o baja batch_size.

# Habilitar caché de traducciones en memoria (reduce llamadas API si hay líneas repetidas)
enable_translation_cache = yes

[MKV_OUTPUT]
# Rutas opcionales
# Ruta a MKVToolNix si NO está en el PATH (vacío = usar PATH del sistema)
mkvtoolnix_dir =

# Configuración de salida MKV
# NOTA: la acción real la define 'output_action' más abajo
# (remux incrusta en el MKV; save_separate_sub guarda .srt aparte).

# ¿Marcar la nueva pista de subtítulos como 'default'? (yes/no)
set_new_sub_default = yes

# Nombre para la pista de subtítulos traducida dentro del MKV
translated_track_name = Español Latino (AI)

# Nombre del archivo MKV de salida (se añade al nombre original)
output_mkv_suffix = .traducido

# ¿Reemplazar archivo MKV original con el nuevo archivo traducido? (yes/no)
# Si es 'no', se creará un archivo nuevo con el sufijo definido en 'output_mkv_suffix'.
# ¡ADVERTENCIA: 'yes' SOBRESCRIBIRÁ TU ARCHIVO ORIGINAL!
replace_original_mkv = no

# Acción de salida: remux (incrustar en MKV) o save_separate_sub (guardar .srt aparte)
output_action = save_separate_sub

# ¿Reordenar pistas existentes (Latino primero)? (yes/no)
reorder_existing_tracks = yes

# Configuración de idiomas
# Idioma destino (para prompt y código MKV)
target_language_name = Español Latino (sin censura)
target_language_codes = es-419, lat, es, spa, und

# Idioma fuente preferido para seleccionar pista
preferred_source_lang = fre

# Palabras clave (separadas por coma) para identificar variantes en nombres de pista
# Usadas SOLO si el código de idioma es genérico (spa/es) y el objetivo no lo es.
# Dejar vacío si no se quiere usar esta heurística.
latino_keywords = latino, latin, latam, latin america, español americano, animo, Spanish[LAT]
spain_keywords = españa, spain, castellano, castilian, español europeo, iberian, european, Spanish[ESP]

# Tag requerido en Sonarr para ejecutar la traducción (dejar vacío para ejecutar siempre)
# NOTA: required_sonarr_tag NO está implementado en el código actual
required_sonarr_tag =

[PROMPTS]
# Template para traducciones por lotes.
# Las líneas siguientes deben tener sangría.
# IMPORTANTE: Usando sistema de NUMERACIÓN [N]: para consistencia.
batch_template =
    Contexto: Estás traduciendo el anime "{series_title}" - Episodio: "{episode_title}".
    Eres un traductor experto de subtítulos especializado en anime. Traduce las siguientes {batch_size_info} líneas de subtítulos al {target_language_name}, siguiendo estas reglas ESTRICTAMENTE:
    1.  **Idioma y Tono**: Usa {target_language_name} natural y sin censura. No traduzcas si el texto ya está en español o si es irrelevante. Tuteo por defecto; voseo únicamente si el nombre del idioma lo indica explícitamente. Traduce SIEMPRE todo el texto: nunca devuelvas el original sin traducir.
    2.  **Preservación**: Mantén SIEMPRE intactos: Nombres propios, términos específicos (Oshiruko, Kunai, etc.), honoríficos japoneses (-san, -chan, -sama).
    3.  **Formato de Entrada/Salida**: Cada línea viene numerada como [N]: Texto. La numeración empieza en [1] —nunca en [0]— y el número va entre corchetes, sin negritas ni símbolos adicionales.
    4.  **DEBES responder manteniendo EXACTAMENTE el mismo formato: [N]: Traducción.**
    5.  **Placeholders**: Preserva etiquetas como __TAG0__, __TAG1__ EXACTAMENTE en su posición relativa.
    6.  **Ortografía y Puntuación**: Usa ortografía impecable. Incluye signos de apertura (¿, ¡), tildes correctas y la letra ñ. Evita modismos regionales excesivos a menos que sea necesario para el tono.
    7.  **Consistencia**: Responde ÚNICAMENTE con las líneas traducidas numeradas. Sin preámbulos, sin frases de cierre ("Aquí tienes:", "Espero que ayude") y sin markdown alrededor del formato.
    8.  **Horarios y números**: los números con dos puntos dentro del texto (p. ej. 21:45) se escriben tal cual; el prefijo [N]: aparece solo al inicio de cada línea.
    9.  **Extensión**: mantén una longitud natural similar a la línea original cuando sea posible.

    Líneas a traducir:
    {batch_text}

    Traducciones:

# Template para traducciones individuales (fallback).
# Las líneas siguientes deben tener sangría.
single_template =
    Contexto: Episodio "{episode_title}" de la serie "{series_title}".

    Eres un traductor experto de subtítulos especializado en anime. Traduce la siguiente línea al {target_language_name} siguiendo estas reglas:

    1.  **Idioma y Tono**: {target_language_name} natural y sin censura. Tuteo por defecto; voseo únicamente si el nombre del idioma lo indica explícitamente. Traduce SIEMPRE: nunca devuelvas el texto original sin traducir.
    2.  **Preservación**: Mantén intactos los nombres propios, términos específicos y honoríficos japoneses (-san, -chan, -sama).
    3.  **Placeholders**: Si el texto contiene etiquetas como __TAG0__, consérvalas EXACTAMENTE donde están.
    4.  **Formato**: Devuelve ÚNICAMENTE la traducción —sin comillas que no estén en el original—, sin markdown, sin preámbulos ni explicaciones.
    5.  **Extensión**: mantén una longitud natural similar a la línea original cuando sea posible.

    Texto original:
    {text}

    Traducción:

[CHAPTERS]
# Generación automática de capítulos estilo anime (OP/ED)
# Requiere: ffmpeg + scipy/numpy/requests/soundfile (se auto-instalan
# con pip en el primer intento si falta alguna)
enabled = yes

# Carpeta persistente para cachear temas descargados de animethemes.moe
# Dejar vacío para desactivar caché (descarga cada vez)
theme_cache_dir = /config/scripts/OPED

# Tamaño máximo de la caché de temas en MB (se borrarán los más antiguos si se supera)
max_theme_cache_mb = 1024

# Días máximos de vida de un archivo en la caché (TTL)
theme_cache_ttl_days = 120

# Timeout en segundos para el cálculo de correlación
correlation_timeout = 120

# Umbral mínimo de score de correlación (peak / downsample_factor)
score_threshold = 2000

# Tolerancia en segundos para snap al inicio/final del episodio
snap_tolerance = 4.0

# Duración del silencio prepuesto al audio del episodio (segundos)
silence_duration = 5.0

# Factor de downsampling para correlación (mayor = más rápido, menos preciso)
downsample_factor = 32

# Porción del tema usada para la correlación (0-1]; maneja temas con fade-out/cortes
theme_portion = 0.9

# Ruta base para limitar generación de capítulos (solo Sonarr)
# Solo se generarán capítulos para archivos dentro de esta ruta
# Dejar vacío para generar capítulos para todas las series
anime_path = /home/biblioteca/Anime

[DEBUG]
# Modo debug: registra en el log cada línea original y su traducción,
# respuestas crudas de la API por batch, decisiones del fallback recursivo
# y restauración de placeholders. Para diagnosticar problemas de parsing.
# false = desactivado, true = registra todas las etapas
# Recomendado: false — con true se vuelcan subtítulos completos al log.
debug_translation = false

# Máximo de caracteres a volcar por respuesta cruda de la API en modo debug.
# 0 = desactiva el volcado crudo. Default: 800
debug_max_chars = 800

# Habilitar actualización automática desde GitHub (yes/no)
auto_update = yes
